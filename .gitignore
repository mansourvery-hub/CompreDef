__pycache__/

*.zip
*.ankiaddon
dist/

*.db

.env

# Ignore all JSON except the add-on's own config.json and manifest.json
*.json
!config.json
!manifest.json
# ... except the frozen picker-audit fixture: the strict Ring 1 test
# reads it on every run (including CI), so it must be committable.
!tests/fixtures/*.json
# Human audit reports are timestamped personal copies, not test data.
debug/reports/
user_files/

